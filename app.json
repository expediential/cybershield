{
  "expo": {
    "name": "CyberShield",
    "slug": "cybershield",
    "version": "0.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.expediential.cybershield",
      "versionCode": 7,
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-status-bar",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ]
  }
}
